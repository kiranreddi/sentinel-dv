{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kiranreddi/sentinel-dv",
  "title": "Sentinel DV",
  "description": "MCP tools for UVM/cocotb logs, coverage, regressions, and waveform triage.",
  "version": "2.3.0",
  "websiteUrl": "https://kiranreddi.github.io/sentinel-dv/",
  "repository": {
    "url": "https://github.com/kiranreddi/sentinel-dv",
    "source": "github",
    "id": "1141861890"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/kiranreddi/sentinel-dv/main/docs/assets/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sentinel-dv",
      "version": "2.3.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "sentinel-dv"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "sentinel-dv-server"
        },
        {
          "type": "named",
          "name": "--config",
          "description": "Path to config.yaml (artifact roots, index path, adapters)",
          "format": "filepath",
          "placeholder": "/absolute/path/to/config.yaml"
        }
      ],
      "environmentVariables": [
        {
          "name": "SENTINEL_DV_CONFIG",
          "description": "Path to config.yaml (alternative to --config)",
          "format": "filepath",
          "placeholder": "/absolute/path/to/config.yaml"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tags": [
        "verification",
        "uvm",
        "systemverilog",
        "cocotb",
        "eda",
        "regression",
        "coverage",
        "jenkins"
      ]
    }
  }
}
